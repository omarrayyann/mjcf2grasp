<mujoco model="panda hand">
    <compiler angle="radian" meshdir="" autolimits="true"/>

    <option integrator="implicitfast"/>

    <default>
        <default class="panda">
            <material specular="0.5" shininess="0.25"/>
            <joint armature="0.1" damping="1" axis="0 0 1" range="-2.8973 2.8973"/>
            <general dyntype="none" biastype="affine" ctrlrange="-2.8973 2.8973" forcerange="-87 87"/>
            <default class="finger">
                <joint axis="0 1 0" type="slide" range="0 0.04"/>
            </default>

            <default class="visual">
                <geom type="mesh" contype="0" conaffinity="0" group="2"/>
            </default>
            <default class="collision">

                <geom group="3" type="box" contype="1" conaffinity="1" condim="3" solimp="0.99 0.995 0.01"
                    solref="0.01 1" friction="1.5 0.02 0.01"/>
                <default class="fingertip_pad_collision_1">
                    <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445"/>
                </default>
                <default class="fingertip_pad_collision_2">
                    <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05"/>
                </default>
                <default class="fingertip_pad_collision_3">
                    <geom type="box" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05"/>
                </default>
                <default class="fingertip_pad_collision_4">
                    <geom type="box" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395"/>
                </default>
                <default class="fingertip_pad_collision_5">
                    <geom type="box" size="0.003 0.002 0.0035" pos="-0.0055 0.002 0.0395"/>
                </default>
            </default>
        </default>
    </default>

    <asset>
        <material class="panda" name="white" rgba="1 1 1 1"/>
        <material class="panda" name="off_white" rgba="0.901961 0.921569 0.929412 1"/>
        <material class="panda" name="black" rgba="0.25 0.25 0.25 1"/>

        <mesh name="hand_c" file="assets/gripper_models/panda_gripper/meshes/hand.stl"/>

        <mesh file="assets/gripper_models/panda_gripper/meshes/hand_0.obj"/>
        <mesh file="assets/gripper_models/panda_gripper/panda_with_frame.obj"/>
        <mesh file="assets/gripper_models/panda_gripper/meshes/hand_1.obj"/>
        <mesh file="assets/gripper_models/panda_gripper/meshes/hand_2.obj"/>
        <mesh file="assets/gripper_models/panda_gripper/meshes/hand_3.obj"/>
        <mesh file="assets/gripper_models/panda_gripper/meshes/hand_4.obj"/>
        <mesh file="assets/gripper_models/panda_gripper/meshes/finger_0.obj"/>
        <mesh file="assets/gripper_models/panda_gripper/meshes/finger_1.obj"/>
    </asset>

    <worldbody>
        <body name="root" pos="0 0 0.0">
            <joint type="free" name="rum_free_joint" damping="1"/>

            <body name="base" childclass="panda" quat="0 0 0 1" gravcomp="1">


                <!-- <geom name="test_sphere_2" type="sphere" rgba="1 0 0 0" size="0.03"/> -->
                <!-- <geom name="pand_with_frame" type="mesh" mesh="panda_with_frame" conaffinity="0" contype="0"
                euler="-1.57 0 0" pos="0 0.035 0"/> -->

                <body name="fixed_rotation" euler="-1.57 0 1.57">

                    <inertial mass="0.73" pos="-0.01 0 0.03" diaginertia="0.001 0.0025 0.0017"/>
                    <geom mesh="hand_0" material="off_white" class="visual"/>
                    <geom mesh="hand_1" material="black" class="visual"/>
                    <geom mesh="hand_2" material="black" class="visual"/>
                    <geom mesh="hand_3" material="white" class="visual"/>
                    <geom mesh="hand_4" material="off_white" class="visual"/>
                    <geom mesh="hand_c" class="collision"/>

                    <body name="tcp" pos="0 0 0.089275" euler="1.57 1.57 0">
                        <site name="tcp" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>
                    </body>

                    <body name="left_finger" pos="0 0 0.0584">
                        <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
                        <joint name="finger_joint1" class="finger"/>
                        <geom name="left_finger_finger_0" mesh="finger_0" material="off_white" class="visual"/>
                        <geom name="left_finger_finger_1" mesh="finger_1" material="black" class="visual"/>
                        <geom name="left_finger_finger_0_0" mesh="finger_0" class="collision"/>
                        <geom name="left_finger_fingertip_pad_collision_1" class="fingertip_pad_collision_1"/>
                        <geom name="left_finger_fingertip_pad_collision_2" class="fingertip_pad_collision_2"/>
                        <geom name="left_finger_fingertip_pad_collision_3" class="fingertip_pad_collision_3"/>
                        <geom name="left_finger_fingertip_pad_collision_4" class="fingertip_pad_collision_4"/>
                        <geom name="left_finger_fingertip_pad_collision_5" class="fingertip_pad_collision_5"/>
                    </body>
                    <body name="right_finger" pos="0 0 0.0584" quat="0 0 0 1">
                        <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
                        <joint name="finger_joint2" class="finger"/>
                        <geom name="right_finger_finger_0" mesh="finger_0" material="off_white" class="visual"/>
                        <geom name="right_finger_finger_1" mesh="finger_1" material="black" class="visual"/>
                        <geom name="right_finger_finger_0_0" mesh="finger_0" class="collision"/>
                        <geom name="right_finger_fingertip_pad_collision_1" class="fingertip_pad_collision_1"/>
                        <geom name="right_finger_fingertip_pad_collision_2" class="fingertip_pad_collision_2"/>
                        <geom name="right_finger_fingertip_pad_collision_3" class="fingertip_pad_collision_3"/>
                        <geom name="right_finger_fingertip_pad_collision_4" class="fingertip_pad_collision_4"/>
                        <geom name="right_finger_fingertip_pad_collision_5" class="fingertip_pad_collision_5"/>
                    </body>
                </body>
            </body>
        </body>

        <body name="target_ee_pose" mocap="true" pos="0 0 0.0">
            <site name="target_ee_pose" pos="0 0 0.0" size="0.01" rgba="0 1 0 1"/>
            <geom name="target_ee_pose" type="box" rgba="0 1 0 0.1" size="0.01 0.01 0.01" conaffinity="0" contype="0"
                mass="10.0"/>
        </body>
    </worldbody>

    <contact>
        <exclude body1="base" body2="left_finger"/>
        <exclude body1="base" body2="right_finger"/>
    </contact>

    <tendon>
        <fixed name="split">
            <joint joint="finger_joint1" coef="0.5"/>
            <joint joint="finger_joint2" coef="0.5"/>
        </fixed>
    </tendon>

    <equality>
        <joint joint1="finger_joint1" joint2="finger_joint2" solimp="0.95 0.99 0.001" solref="0.005 1"/>
        <weld site1="target_ee_pose" site2="tcp" solref="0.01 1" solimp="0.9 0.95 0.001"/>

    </equality>

    <actuator>
        <!-- Remap original ctrlrange (0, 0.04) to (0, 255): 0.04 * 100 / 255 = 0.01568627451 -->
        <general class="panda" name="panda_hand" tendon="split" forcerange="-100 100" ctrlrange="0 255"
            gainprm="0.23529411764 0 0" biasprm="-30 0 -375"/>
    </actuator>


</mujoco>